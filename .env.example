# 이 파일을 .env 로 복사한 뒤 값을 채우세요.  (cp .env.example .env)
# .env 는 .gitignore 에 포함되어 있으며 저장소에 올리면 안 됩니다.
#
# 앱키/시크릿키 확인: LS증권 홈페이지 > 고객센터 > 매매시스템 > API > 사용등록/해지
# 실전투자와 모의투자는 앱키가 별도로 발급됩니다.
# 따옴표는 선택이고, 같은 줄 끝에 주석(#)을 붙이지 마세요.

LS_APP_KEY=YOUR_APP_KEY
LS_APP_SECRET=YOUR_APP_SECRET

# (선택) REST 서버 주소. 비워 두면 기본값 https://openapi.ls-sec.co.kr:8080 을 사용합니다.
# LS_BASE_URL=
